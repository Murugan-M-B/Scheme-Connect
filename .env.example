# Frontend Environment Variables
# Copy this file to .env.local for local development
# For production (Vercel), set these in the Vercel project dashboard under Settings > Environment Variables

# Backend API URL — set this to your Render backend URL after deploying
# Example: https://scheme-connect-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1
